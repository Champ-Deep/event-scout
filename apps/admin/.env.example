# Admin console build settings (read at `vite build` time — changing them needs a rebuild).

# VITE_API_URL — the backend origin, e.g. https://api.your-domain (no trailing slash, no /api).
# Leave it unset in development: the Vite dev server proxies /api, /login/ and /auth/* to
# http://localhost:8000. Set it when the built console (dist/) is hosted on a different origin from
# the backend; that backend must then allow this console's origin in its CORS settings.
# The host must serve index.html for unknown paths (SPA fallback) so deep links like /contacts/123
# load: public/_redirects (Netlify / Cloudflare Pages) and vercel.json (Vercel) already do this.
VITE_API_URL=
