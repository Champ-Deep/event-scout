# API Keys - Copy this file to .env and fill in your values
# NEVER commit .env to version control

# ============================================
# PRODUCTION DEPLOYMENT INSTRUCTIONS
# ============================================
# 1. Generate a secure API key:
#    python3 -c "import secrets; print(secrets.token_urlsafe(32))"
#
# 2. Get your OpenRouter API key from:
#    https://openrouter.ai/keys   (add credits under https://openrouter.ai/credits)
#
# 3. For Railway deployment:
#    - Add these as environment variables in Railway dashboard
#    - DO NOT commit .env to git
# ============================================

# production = refuse to start without APP_API_KEY / JWT_SECRET / DATABASE_URL (set automatically in the
# Docker image and on Railway). Leave unset for local development.
# ENVIRONMENT=production

# Database. Production: PostgreSQL (postgresql://user:pass@host:5432/db). Local: sqlite:///./eventscout.db
# DATABASE_PUBLIC_URL, when set, is used instead of DATABASE_URL (Railway's public proxy URL).
DATABASE_URL=sqlite:///./eventscout.db
# Optional second database that "Back up now" (admin → System) copies into.
BACKUP_DATABASE_URL=
# Seconds one SQL statement may run on Postgres (default 30)
# DB_COMMAND_TIMEOUT=30

# Application API key for route authentication (16+ characters)
# Generate one with the command above (the mobile app's EXPO_PUBLIC_API_KEY must match it)
APP_API_KEY=your_app_api_key_here

# Admins: sign-ups are never made admin automatically (emails aren't verified). Create the first admin
# with `python manage_admins.py grant you@company.com`, then promote others on the console's Team page.
# ADMIN_EMAILS (comma-separated) only auto-promotes accounts that sign in with a LinkedIn-verified email.
ADMIN_EMAILS=

# ============================================
# AI (OpenRouter) — card reading, lead scoring, chat (incl. files), voice input, research/pitch
# ============================================
# Required for every AI feature. Without it those features answer "not set up on the server".
OPENROUTER_API_KEY=your_openrouter_api_key_here
# Optional: models (any OpenRouter model id). The default must support images + audio input.
OPENROUTER_MODEL=google/gemini-2.5-flash
OPENROUTER_FALLBACK_MODELS=google/gemini-2.0-flash-001

# Optional: Brave Search API key (https://api-dashboard.search.brave.com). "Find on LinkedIn" then
# shows profile photos from Brave Image Search even when LinkedIn refuses to load profile pages.
# Without it, photos come from LinkedIn (when it allows) and Gravatar.
BRAVE_SEARCH_API_KEY=
# Per-feature overrides (default = OPENROUTER_MODEL)
# OPENROUTER_VISION_MODEL=
# OPENROUTER_AUDIO_MODEL=
# OPENROUTER_CHAT_MODEL=
# Sent as HTTP-Referer for OpenRouter app attribution
# OPENROUTER_REFERER=https://your-domain

# ============================================
# AUTH (JWT)
# ============================================
# HS256 signing secret for the access/refresh tokens issued by /login/ and /register/ (32+ characters,
# never the APP_API_KEY). REQUIRED in production. Locally, unset = a generated key kept in jwt_secret.key.
# Changing it signs everyone out.
JWT_SECRET=your_jwt_signing_secret_here
# Optional token lifetimes (defaults shown)
JWT_ACCESS_TTL_HOURS=12
JWT_REFRESH_TTL_DAYS=30

# ============================================
# LINKEDIN OAUTH (Sign In with LinkedIn using OpenID Connect)
# ============================================
# Leave blank to disable LinkedIn sign-in (the app then shows "not configured").
# The redirect URI must EXACTLY match one registered in your LinkedIn app AND your
# running app origin (e.g. http://localhost:8081/callback for web dev).
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_REDIRECT_URI=http://localhost:8081/callback
# The installed mobile app signs in through this API's page (LinkedIn only allows https redirects).
# Default: PUBLIC_BASE_URL + /auth/linkedin/app-return — add that exact URL to the LinkedIn app's
# authorized redirect URLs.
# LINKEDIN_NATIVE_REDIRECT_URI=

# ============================================
# EMAIL (password reset codes)
# ============================================
# Any SMTP provider works (Amazon SES, SendGrid, Resend, Mailgun, Gmail app password…).
# Leave SMTP_HOST blank to disable "Forgot password?" (the app then shows "not configured").
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# Sender address, e.g. "EventScout <no-reply@yourdomain.com>" (defaults to SMTP_USERNAME)
SMTP_FROM=
# true = implicit TLS (usually port 465); false = STARTTLS (usually port 587, or 25)
SMTP_USE_SSL=false
# Company mail server with a self-signed certificate: point SMTP_CA_FILE at its certificate (PEM),
# or set SMTP_TLS_VERIFY=false (still encrypted, but the server isn't verified — trusted servers only).
# Check the settings with: python send_test_email.py you@yourdomain.com
SMTP_CA_FILE=
SMTP_TLS_VERIFY=true
# LOCAL DEVELOPMENT ONLY: print reset codes to the server log instead of emailing them.
PASSWORD_RESET_DEV_LOG=false

# ============================================
# LOCAL / DEMO
# ============================================
# Seed sample users + demo contacts into an empty database at startup.
# Default false — a fresh deployment starts empty instead of with fabricated leads.
SEED_DEMO_DATA=false

# Browser origins allowed to call the API (comma-separated), e.g. https://admin.your-domain.
# Unset = any origin (auth is header-based, so this is optional hardening).
CORS_ORIGINS=

# Public https address of this API, used in contact share links, card pages and the n8n callback.
# Set it in production. Unset = the address the app called (only works on the same network).
PUBLIC_BASE_URL=

# n8n integration (optional): every new contact is POSTed to WEBHOOK_URL; n8n posts enrichment back to
# PUBLIC_BASE_URL/contact/{id}/enrich with the header X-Webhook-Secret: ENRICH_WEBHOOK_SECRET.
WEBHOOK_URL=
ENRICH_WEBHOOK_SECRET=
# Research → pitch → deck pipeline after every card / QR scan (costs AI credits per scan)
AUTO_PIPELINE_ENABLED=false

# Sign-in / sign-up / reset rate limits (on by default). "off" only for automated test runs.
# AUTH_RATE_LIMITS=on
# Interactive API docs (/docs) are off in production; true turns them on.
# ENABLE_API_DOCS=false

# 
# CRM (admin console → Exports → Send to CRM). Set only the ones you use; restart after changing.
# CRM-ready CSV downloads work without any of these.
# 
# HubSpot: private app token (scopes crm.objects.contacts.read + write; notes write for the EventScout note)
HUBSPOT_ACCESS_TOKEN=
# Salesforce: connected app with the OAuth client-credentials flow enabled; DOMAIN = your My Domain host
SALESFORCE_DOMAIN=
SALESFORCE_CLIENT_ID=
SALESFORCE_CLIENT_SECRET=
# SALESFORCE_API_VERSION=v61.0
# SALESFORCE_LEAD_SOURCE=EventScout
# Zoho CRM: self-client refresh token (scope ZohoCRM.modules.leads.ALL)
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_REFRESH_TOKEN=
# ZOHO_ACCOUNTS_URL=https://accounts.zoho.com   (.eu / .in / .com.au for other data centres)
# ZOHO_API_VERSION=v6
# ZOHO_LEAD_SOURCE=EventScout
# Pipedrive: personal API token (Settings → Personal preferences → API)
PIPEDRIVE_API_TOKEN=
# PIPEDRIVE_COMPANY_DOMAIN=yourcompany
# ============================================
# OPTIONAL TUNING (defaults shown — leave unset unless you need them)
# ============================================
# DATABASE_PUBLIC_URL=            # used instead of DATABASE_URL when set (Railway's public proxy URL)
# JWT_SECRET_FILE=./jwt_secret.key  # local dev only: where the generated JWT secret is kept when JWT_SECRET is unset
# SCORING_RUNS=3                  # AI answers per score (median of them; 1-5) — more = steadier scores, more AI cost
# BACKUP_INTERVAL_HOURS=          # automatic backups every N hours (needs BACKUP_DATABASE_URL); unset = only "Back up now"
# BACKUP_KEEP=10                  # SQLite snapshots kept in backend/backups/ when there's no BACKUP_DATABASE_URL
# OPENROUTER_BASE_URL=            # only for a proxy / gateway in front of OpenRouter
# GAMMA_API_KEY=                  # pipeline: build pitch decks with Gamma.app (otherwise no deck)
# PRESENTON_API_URL=              # legacy deck generator (self-hosted Presenton); PRESENTON_API_KEY if it needs one
# PRESENTON_API_KEY=
# Email verification (POST /api/email/verify, email_verify.py)
# EMAIL_VERIFY_SMTP=1             # 0 = skip the mail-server (RCPT TO) step; port 25 is blocked on many hosts
# EMAIL_VERIFY_FROM=              # sender address used in that SMTP conversation
# EMAIL_VERIFY_HELO=              # HELO name used in that SMTP conversation
# EMAIL_VERIFY_TIMEOUT=10         # seconds
# REACHER_BACKEND_URL=            # use a Reacher server instead (docker run -p 8080:8080 reacherhq/backend)
# REACHER_SECRET=
