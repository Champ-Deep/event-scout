# Copy this file to .env and fill in real values there.
# Never commit .env. Placeholders below are not credentials.
# Keys that were previously committed are still in git history.
# Rotate them. This change does not rewrite history.

# Required. Authenticates scripts and signs browser session tokens.
APP_API_KEY=YOUR_APP_API_KEY

# Required for business-card OCR and lead scoring.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Optional AI and integration credentials. Leave blank when unused.
OPENROUTER_API_KEY=YOUR_OPENROUTER_API_KEY
PRESENTON_API_KEY=
GAMMA_API_KEY=
WEBHOOK_URL=
PRESENTON_API_URL=

# Comma-separated admin emails. Defaults to the built-in admin list when unset.
ADMIN_EMAILS=

# Browser session lifetime in seconds. Default is 30 days.
SESSION_TTL_SECONDS=2592000

AUTO_PIPELINE_ENABLED=false
BACKUP_INTERVAL_HOURS=6

# Database URLs are supplied by the host (for example Railway). Do not commit them.
DATABASE_URL=
DATABASE_PUBLIC_URL=
BACKUP_DATABASE_URL=

# Used by scripts that call a deployed API. Not read by the server.
TEST_EMAIL=
TEST_PASSWORD=
