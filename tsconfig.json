{
  "extends": "./packages/config/tsconfig/base.json",
  "compilerOptions": {
    "baseUrl": ".",
    "jsx": "react-jsx",
    "paths": {
      "@es/types": ["packages/types/src/index.ts"],
      "@es/types/*": ["packages/types/src/*"]
    }
  },
  "include": [
    "packages/**/*",
    "apps/**/*"
  ],
  "exclude": [
    "node_modules",
    "**/node_modules/*"
  ]
}
